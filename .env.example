# The default needs no key: BR_LLM_MODE=replay plays back recorded model answers, and everything else runs for real.
BR_LLM_MODE=replay

# To review your own requests with a model of your choice, uncomment and fill in:
# BR_LLM_MODE=live
# BR_LLM_PROVIDER=openai        # openai, anthropic, gemini, bedrock... see the AI Hub provider list
# BR_LLM_MODEL=gpt-5-nano
# BR_LLM_API_KEY=your-key-here
# BR_LLM_BASE_URL=              # any OpenAI-compatible endpoint; leave empty for the provider's default

# A free local model through Ollama running on the host:
# BR_LLM_MODE=live
# BR_LLM_PROVIDER=openai
# BR_LLM_MODEL=gemma4:31b
# BR_LLM_API_KEY=none
# BR_LLM_BASE_URL=http://host.docker.internal:11434/v1

# How long one review may take in live mode, in seconds. The default is 900.
# BR_LLM_TIMEOUT_S=900
